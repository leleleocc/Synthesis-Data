# Copy this file outside the repository, fill in the values, and protect it
# with chmod 600. scripts/run-production.sh sources it as trusted shell input.

# Daytona is used for both the outer constructor and its nested Harbor runs.
DAYTONA_API_KEY=

# Outer task-constructor agent. The endpoint must be compatible with Claude Code's
# Anthropic environment-variable interface.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
HARBOR_CONSTRUCTOR_MODEL=
# Optional. Leave empty to use the model/provider default.
HARBOR_CONSTRUCTOR_REASONING_EFFORT=

# Target arm: the model whose task performance should remain below 0.7.
HARBOR_TARGET_MODEL_NAME=
HARBOR_TARGET_BASE_URL=
HARBOR_TARGET_AUTH_TOKEN=
# Optional.
HARBOR_TARGET_REASONING_EFFORT=

# Solver arm: the stronger reference model used to establish separation.
HARBOR_SOLVER_MODEL_NAME=
HARBOR_SOLVER_BASE_URL=
HARBOR_SOLVER_AUTH_TOKEN=
# Optional.
HARBOR_SOLVER_REASONING_EFFORT=

# Agent-judge endpoint used for diagnostic criteria. Programmatic scores alone
# determine the target/solver separation ratio.
HARBOR_JUDGE_BASE_URL=
HARBOR_JUDGE_AUTH_TOKEN=
