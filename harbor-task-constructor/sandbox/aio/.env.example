# AIO Sandbox path only. The Daytona constructor keeps its own /.env.example.
#
# Copy to sandbox/aio/.env, fill in, and chmod 600. The `sbx` CLI reads it on the
# host; the in-sandbox runner takes plain paths and needs none of these.
#
# This file holds the *operator's* settings: which account, which application,
# which bucket. The tenant's model token lives in task.env — see the note at the
# bottom, and task.env.example next to this file.

# --- Volcengine account -------------------------------------------------------
# Optional. Left empty, the SDK falls back to its default credential chain —
# env vars, OIDC federation, ~/.volcengine/config.json, then the ECS instance
# role over IMDS — so on a Volcengine ECS with a role bound this file needs no
# secret at all. Set the pair only when there is no ambient identity to use.
#
# These keys never enter a sandbox. The host makes every API call and no
# instance is granted a RoleTrn, which is what keeps the blast radius of
# anything running inside the sandbox bounded to that sandbox.
VOLC_ACCESSKEY=
VOLC_SECRETKEY=
# For STS temporary credentials, alongside the pair above.
VOLC_SESSION_TOKEN=
VOLC_REGION=cn-beijing

# --- Sandbox application ------------------------------------------------------
# FunctionId of the sandbox application, from the veFaaS console under
# 云沙箱 > 沙箱应用. Instances are created against it, and `sbx app sync` writes
# its mount configuration.
VEFAAS_FUNCTION_ID=

# Image the instance runs. Set at least one of these, or InstanceImageInfo can
# carry only a Command and the platform may fall back to the application's own
# startup command, which would skip bootstrap.sh. Avoid ports 9000, 9001, 9990.
SANDBOX_IMAGE=
SANDBOX_IMAGE_ID=
SANDBOX_IMAGE_PORT=8080
# Leave empty. `sbx task create` then generates `exec $SANDBOX_APP_COMMAND`.
# bootstrap.sh is not started from here at all — it is triggered by the image's
# RUN_HOOK_POST_READY, which sbx sets per sandbox. Set this only to override the
# startup command entirely.
SANDBOX_IMAGE_COMMAND=

# The application's own entrypoint, from GetFunction. The generated Command
# execs exactly this, so the instance reaches ready on its port as usual;
# bootstrap.sh runs afterwards, from the post-ready hook.
SANDBOX_APP_COMMAND=/opt/gem/run.sh

# How long bootstrap.sh keeps the instance alive after it finishes, so the
# webshell can still be used to look around.
KEEP_ALIVE_SECONDS=3600

# Instance sizing. Memory is the constrained resource: the default 2048 must be
# raised, since the construction run and the Claude Code agent share it.
SANDBOX_CPU_MILLI=1000
SANDBOX_MEMORY_MB=8192
# Sandbox lifetime (3-1440 minutes). Set well above the construction deadline.
SANDBOX_TIMEOUT_MINUTES=1440
# Lowercase: the API rejects "Minute" with
# "request TimeoutUnit must be minute or second".
SANDBOX_TIMEOUT_UNIT=minute

# --- TOS ----------------------------------------------------------------------
# Endpoint is region-specific, e.g. tos-cn-beijing.volces.com. The internal
# endpoint (tos-*-internal) is reachable only from inside the VPC; set
# TOS_PUBLIC_ENDPOINT when the host uploads from outside it.
TOS_ENDPOINT=
TOS_PUBLIC_ENDPOINT=
TOS_BUCKET=
# Prefix inside the bucket. Everything the CLI addresses hangs off it:
#
#   <path>/_runtime/<version>/   bootstrap.sh + runner/, shared, read-only
#   <path>/_templates/<name>/    one tenant's PROMPT.md, init.sh, verify.sh
#   <path>/<task-id>/            one task's seed/, archives/, runs/
#   <path>/_unassigned/          the deliberately-empty default backend
#
# The mount is already narrowed to the task, so no path inside the sandbox
# repeats the task id. See sbx/mounts.py — the paths are generated there, and
# nothing else may hard-code them.
TOS_BUCKET_PATH=/sandbox
# Which runtime release `sbx app sync` declares and `sbx runtime publish`
# writes. Bumping it is how a runtime change rolls out; overridable per run.
RUNTIME_VERSION=v1
# Optional. Passed through to the mount's auth_mode when the bucket needs
# something other than the application's default.
TOS_AUTH_MODE=
# Parallel parts per upload. Raise it on a fat link, lower it on a thin one.
TOS_UPLOAD_TASKS=12

# --- NAS ----------------------------------------------------------------------
# The working tree. Mounted at /home/app, so the workspace is /home/app/workspace.
# NAS_REMOTE_PATH is a prefix on the file system, narrowed to <prefix>/<task-id>
# per instance — the mount itself is what isolates one task from another.
#
# NAS auto-creates a missing remote_path, so unlike TOS these prefixes need no
# .keep placeholder. Note also that NasConfig has no read_only field: NAS is
# always writable and any read-only intent has to be enforced by our own code.
NAS_REMOTE_PATH=/harbor
# Both optional. Left empty, `sbx app sync` carries forward whatever the live
# application already has, which is normally what you want — set them only to
# point the application at a different file system or mount point.
NAS_FILE_SYSTEM_ID=
NAS_MOUNT_POINT_ID=
# The image runs as uid=gid=1000, so these must match or the tree is unwritable.
NAS_UID=1000
NAS_GID=1000

# --- runner -------------------------------------------------------------------
# The settings in this section, plus KEEP_ALIVE_SECONDS, RUNTIME_VERSION and
# SANDBOX_TIMEOUT_MINUTES, can be overridden per invocation from the process
# environment:
#
#   CONSTRUCT_MAX_ITERATIONS=3 sandbox/aio/sbx.sh task create <task-id> <dir>
#
# so a one-off run needs no edit here — and, more to the point, no second copy of
# this file. Credentials, bucket, and mount paths are deliberately NOT
# overridable: those decide which account and which task an instance is created
# against, and picking them up from an ambient shell variable is how you create
# one against the wrong one.
#
# One constructor works a task at a time. The lease that enforces that lives at
# /home/app/.lease and is held by owner + heartbeat rather than by a lock, so a
# holder that dies is detected instead of walling the task off forever.
#
# The stale window must stay below the interval at which a *failing* instance is
# retried (measured at ~120 s), since every retry re-runs the startup script
# against the same NAS directory. Above that, a dead holder's lease outlives it
# and the next run in stands down for a process that no longer exists.
LEASE_HEARTBEAT_SECONDS=15
LEASE_STALE_SECONDS=90

# How many times the agent is re-run against the template's PROMPT.md before the
# loop gives up. The budget, not the goal: a template is expected to stop itself
# by writing .done into the workspace, and this only bounds the cost when it does
# not. A stall — three consecutive iterations that change no file — stops it
# sooner. Neither is a failure: both archive the tree and report done: false.
CONSTRUCT_MAX_ITERATIONS=10

# Which subcommand bootstrap.sh hands the runner: empty for the full lifecycle,
# "probe" for preflight + survey with nothing written to NAS.
BOOTSTRAP_ARGS=

# Extra paths for preflight to report present/missing, comma-separated. This is
# how a single create call asks a question about the image without cutting a new
# runtime release.
PROBE_PATHS=

# --- 这里没有模型凭证，是有意的 -------------------------------------------------
# 本文件只负责"把沙箱跑起来"：账号、应用、镜像、四个挂载点。构造本身要花的钱不在这里。
#
# 实例里跑的 claude -p 用的是**业务方自己的** token。业务方交一个 task.env 过来
# （见 task.env.example），sbx 在主机侧读它、注入成实例的环境变量，**文件本体不进沙箱**，
# 所以凭证不会落在 TOS、NAS 或任何归档包里（见 TODO.md 第 1、8 节）。
# 谁的构造花谁的额度，接入方不必替所有租户垫钱，也不必替他们保管 token。
