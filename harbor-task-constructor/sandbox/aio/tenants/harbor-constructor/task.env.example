# Harbor constructor tenant credentials.
# Copy to task.env and fill in values. task.env is gitignored and never enters
# a sandbox instance — the host injects values as environment variables only.

# Daytona / Harbor runner
DAYTONA_API_KEY=
HARBOR_JUDGE_BASE_URL=
HARBOR_JUDGE_AUTH_TOKEN=

# Target model arm
HARBOR_TARGET_MODEL_NAME=
HARBOR_TARGET_BASE_URL=
HARBOR_TARGET_AUTH_TOKEN=
HARBOR_TARGET_REASONING_EFFORT=

# Solver model arm
HARBOR_SOLVER_MODEL_NAME=
HARBOR_SOLVER_BASE_URL=
HARBOR_SOLVER_AUTH_TOKEN=
HARBOR_SOLVER_REASONING_EFFORT=

# Anthropic API key (for the claude -p agent inside the sandbox)
ANTHROPIC_API_KEY=
