{
  "deployment_mode": "single",
  "base_image": "ubuntu:24.04",
  "services": [
    {
      "name": "main",
      "image_or_build": "synth-env:03",
      "ports": [],
      "healthcheck": "bash /opt/env/smoke_test.sh"
    }
  ],
  "dependencies": {
    "system": [
      "build-essential",
      "pkg-config",
      "libssl-dev",
      "tcl8.6",
      "tclx",
      "git",
      "ca-certificates",
      "time",
      "procps"
    ],
    "language": [
      "c",
      "shell"
    ],
    "pinned": true
  },
  "asset_paths": [],
  "network_policy": "build_only",
  "workdir": "/app",
  "data_dir": "/data",
  "results_dir": "/results",
  "entrypoints": [
    "make",
    "gcc",
    "/app/Makefile",
    "/app/src/Makefile",
    "/app/runtest",
    "/app/redis.conf"
  ],
  "build": {
    "status": "passed",
    "mode": "docker",
    "buildable": true,
    "smoke_test": true,
    "build_seconds": 56,
    "failures": []
  }
}
